# ── ReviewIQ Backend Environment Example ──

NODE_ENV=production
APP_PORT=3000
API_PREFIX=api/v1
FRONTEND_DOMAIN=https://your-frontend.vercel.app
BACKEND_DOMAIN=https://your-backend.onrender.com

# PostgreSQL Connection
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Redis Connection
REDIS_HOST=your_redis_host
REDIS_PORT=6379

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_LOGIN_CALLBACK_URL=https://your-backend.onrender.com/api/v1/auth/google/login/callback
GOOGLE_REGISTER_CALLBACK_URL=https://your-backend.onrender.com/api/v1/auth/google/register/callback

# Stripe Billing Credentials
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_SUCCESS_URL=https://your-frontend.vercel.app/dashboard
STRIPE_CANCEL_URL=https://your-frontend.vercel.app/pricing

# Email Server (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password_here
MAIL_FROM_NAME=ReviewIQ Support
MAIL_FROM_EMAIL=support@example.com

# AI Microservice URL (Render)
ANALYTICS_BUSINESSES_URL=https://your-ai-service.onrender.com/businesses
ANALYTICS_LOCATIONS_URL=https://your-ai-service.onrender.com/businesses/locations
ANALYTICS_REPORTS_URL=https://your-ai-service.onrender.com/reports/monthly

# Initial Admin Credentials
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change_this_in_production
