model System {
  systemId              String   @id @default(uuid())
  supportEmail          String
  supportUrl            String
  siteName              String
  supportPhone          String?
  location              String?
  freeTrialDuration     Int?
  planLimitMaxBusiness  Int?
  planLimitMaxLocations Int?
  isMaintenanceMode     Boolean  @default(false)
  emailNotifications    Boolean  @default(true)
  allowSignups          Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
